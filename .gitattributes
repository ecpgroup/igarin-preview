# Fix line endings so Windows checkouts never produce phantom diffs.
# index.html was committed with CRLF; Prettier writes LF (endOfLine: "lf"),
# so normalise HTML to LF in the repository and in the working tree.
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
.prettierrc    text eol=lf
.gitattributes text eol=lf

# Binary assets must never be touched by EOL conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.mp4  binary
*.webm binary
*.pdf  binary
*.woff  binary
*.woff2 binary
